{
  "name": "PhaiCityJS",
  "version": "0.0.1",
  "description": "A port of the open-source simulator \"Micropolis\" to Javascript/HTML5",
  "repository": {
    "type": "git",
    "url": "https://github.com/graememcc/micropolisJS.git"
  },
  "bugs": {
    "url": "https://github.com/graememcc/micropolisJS/issues"
  },
  "type": "module",
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --watch --mode development",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "tslint src/*.ts test/*.ts",
    "dev": "webpack serve --mode development",
    "Dev": "webpack serve --mode development",
    "gallery": "webpack serve --mode development --open /model-gallery.html",
    "sound": "webpack serve --mode development --open /sound-gallery.html",
    "production": "webpack serve --mode production",
    "textures:convert": "node src/render3d/dev/convert-textures.ts",
    "geo:national": "node scripts/geo/national.mjs",
    "geo:centers": "node scripts/geo/centers.mjs",
    "geo:edges": "node scripts/geo/edges.mjs",
    "geo:neighbors": "node scripts/geo/neighbors.mjs",
    "geo:download": "node scripts/geo/provinceData.mjs",
    "geo:dem": "node scripts/geo/demDownload.mjs",
    "geo:indicators": "node scripts/geo/indicators.mjs",
    "geo:extract": "node scripts/geo/osmExtract.mjs",
    "geo:maps": "node scripts/geo/maps.mjs",
    "geo:city": "node scripts/geo/cityMaps.mjs",
    "geo:districts": "node scripts/geo/districts.mjs",
    "geo:review": "webpack serve --mode development --open /geo-review.html",
    "test:geo": "node --test \"test/geo/*.test.mjs\"",
    "test:server": "npm --prefix server test",
    "i18n:import": "node scripts/i18n/import-ui-strings.mjs",
    "theme:css": "node scripts/theme/build-css.mjs",
    "audio:build": "node scripts/audio/build-sfx.mjs",
    "art:export": "webpack serve --mode development --open /art-export.html",
    "art:blend": "node scripts/blender/run.mjs"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/three": "0.186.0",
    "@types/topojson-client": "3.1.5",
    "clean-webpack-plugin": "4.0.0",
    "copy-webpack-plugin": "13.0.0",
    "git-revision-webpack-plugin": "5.0.0",
    "html-webpack-plugin": "5.6.3",
    "jest": "30.0.4",
    "mapshaper": "0.7.83",
    "playwright": "1.48.2",
    "sharp": "0.35.5",
    "ts-jest": "29.4.0",
    "ts-loader": "9.5.2",
    "typescript": "5.8.3",
    "webpack": "5.100.1",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.2"
  },
  "author": "Graeme McCutcheon (http://www.graememcc.co.uk)",
  "license": "GPL-3.0",
  "readmeFilename": "README.md",
  "dependencies": {
    "jquery": "3.7.1",
    "meshoptimizer": "1.1.1",
    "three": "0.186.1",
    "topojson-client": "3.1.0"
  }
}
