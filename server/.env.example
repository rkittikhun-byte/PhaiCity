# PhaiCity API settings (docs/server/SERVER_SPEC.md section 8).
# On the VPS: copy to /etc/phaicity/server.env, fill in, then `chmod 600`. Never commit the real file.

# The site's address; also the only Origin allowed to change things
PUBLIC_URL=https://phaicity.com
# The API listens on 127.0.0.1 only; nginx passes /api/ to it
PORT=8787
# A PostgreSQL user that owns only the phaicity database
DATABASE_URL=postgres://phaicity:CHANGE_ME@127.0.0.1:5432/phaicity

# LINE Developers → LINE Login channel; callback https://phaicity.com/api/auth/line/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Google Cloud → OAuth client (web); redirect https://phaicity.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
